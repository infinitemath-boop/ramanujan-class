rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teachers sign in with Google. Keep this list in step with ADMINS in public/firebase-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['infinitemath@ramanujanclass.org'];
    }

    // A student may read class material only while their account is active and not expired.
    function isStudent() {
      let path = /databases/$(database)/documents/accounts/$(request.auth.uid);
      let a = get(path).data;
      return request.auth != null
        && exists(path)
        && a.active == true
        && (a.get('validUntilMs', 0) == 0 || request.time.toMillis() < a.validUntilMs);
    }

    function canRead() { return isAdmin() || isStudent(); }

    // Account status (name, batch, active, access date). A student can see only their own.
    match /accounts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Email IDs and phone numbers: teachers only.
    match /roster/{uid} {
      allow read, write: if isAdmin();
    }

    match /announcements/{id} { allow read: if canRead(); allow write: if isAdmin(); }
    match /content/{id}       { allow read: if canRead(); allow write: if isAdmin(); }
    match /days/{id}          { allow read: if canRead(); allow write: if isAdmin(); }
    match /tests/{id}         { allow read: if canRead(); allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if canRead(); allow write: if isAdmin(); }

    // Weekly test results: everyone in the class sees the rank list; a student writes only their own entry.
    match /results/{test}/entries/{uid} {
      allow read: if canRead();
      allow write: if isStudent() && request.auth.uid == uid;
    }

    // Doubt Corner: doubts and feedback with replies. A post with vis "teacher" is seen only by its author and the teacher.
    function boardOpen(d) {
      return isAdmin() || (isStudent() && (d.vis == 'class' || d.uid == request.auth.uid));
    }
    function goodText(t, max) { return t is string && t.size() <= max; }
    match /board/{id} {
      allow read: if boardOpen(resource.data);
      allow create: if (isAdmin() || isStudent())
        && request.resource.data.keys().hasOnly(['kind','sid','title','body','vis','uid','name','teacher','createdAt','lastAt','replies','teacherReplied','solved','pinned'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.teacher == isAdmin()
        && request.resource.data.kind in ['doubt','feedback']
        && request.resource.data.vis in ['class','teacher']
        && goodText(request.resource.data.title, 150) && request.resource.data.title.size() > 0
        && goodText(request.resource.data.body, 3000)
        && goodText(request.resource.data.name, 120)
        && request.resource.data.replies == 0
        && request.resource.data.teacherReplied == false
        && request.resource.data.pinned == false;
      allow update: if isAdmin()
        || (isStudent() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved','replies','lastAt']))
        || (isStudent() && resource.data.vis == 'class'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies','lastAt']));
      allow delete: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid && resource.data.replies == 0);

      match /replies/{r} {
        allow read: if boardOpen(get(/databases/$(database)/documents/board/$(id)).data);
        allow create: if boardOpen(get(/databases/$(database)/documents/board/$(id)).data)
          && request.resource.data.keys().hasOnly(['body','uid','name','teacher','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.teacher == isAdmin()
          && goodText(request.resource.data.body, 3000) && request.resource.data.body.size() > 0
          && goodText(request.resource.data.name, 120);
        allow delete: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid);
      }
    }

    // Uploaded PDFs, videos and thumbnails, stored as chunks.
    match /files/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
      match /chunks/{n} {
        allow read: if canRead();
        allow write: if isAdmin();
      }
    }
  }
}
