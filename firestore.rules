rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teachers sign in with Google. Keep this list in step with ADMINS in public/firebase-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['infinitemath@ramanujanclass.org'];
    }

    // A student may read class material only while their account is active and not expired.
    function isStudent() {
      let path = /databases/$(database)/documents/accounts/$(request.auth.uid);
      let a = get(path).data;
      return request.auth != null
        && exists(path)
        && a.active == true
        && (a.get('validUntilMs', 0) == 0 || request.time.toMillis() < a.validUntilMs);
    }

    function canRead() { return isAdmin() || isStudent(); }

    // Account status (name, batch, active, access date). A student can see only their own.
    match /accounts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Email IDs and phone numbers: teachers only.
    match /roster/{uid} {
      allow read, write: if isAdmin();
    }

    match /announcements/{id} { allow read: if canRead(); allow write: if isAdmin(); }
    match /content/{id}       { allow read: if canRead(); allow write: if isAdmin(); }
    match /days/{id}          { allow read: if canRead(); allow write: if isAdmin(); }
    match /tests/{id}         { allow read: if canRead(); allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if canRead(); allow write: if isAdmin(); }

    // Uploaded PDFs, videos and thumbnails, stored as chunks.
    match /files/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
      match /chunks/{n} {
        allow read: if canRead();
        allow write: if isAdmin();
      }
    }
  }
}
